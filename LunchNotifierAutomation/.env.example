# Copy this file to ".env" (same folder as the scripts) and fill in your
# real values. Never commit the actual .env file to git or share it —
# it's already listed in .gitignore.
#
# One .env file covers every script in this project:
#   LunchNotifier.py, greythr_lunch_automation.py,
#   greythr_lunch_poller.py, greythr_lunch_server.py

# --- greytHR login ---------------------------------------------------
GREYTHR_USER=NJS0024
GREYTHR_PASS=your_password_here

# --- Google Chat ------------------------------------------------------
# From Manage webhooks in your Chat space.
WEBHOOK_URL=your_webhook_url_here

# --- Only needed for greythr_lunch_poller.py and greythr_lunch_server.py ---
# A password only your iPhone Shortcut knows. Pick something random —
# anyone with this can trigger your attendance, so treat it like a password.
SHARED_SECRET=change_this_to_something_random

# --- Only needed for greythr_lunch_poller.py ---------------------------
# The Web App URL from deploying AppsScript_Code.gs (see
# APPS_SCRIPT_SETUP.md). Ends in /exec.
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# How often the poller checks in, in seconds. Optional — defaults to 10.
POLL_INTERVAL_SECONDS=10

# --- NOT covered by this .env file --------------------------------------
# AppsScript_Code.gs runs on Google's servers, not your PC, so it can't
# read this file at all. Its SHARED_SECRET is set separately via
# Script Properties inside the Apps Script project itself — see
# APPS_SCRIPT_SETUP.md for the exact steps. Use the SAME value there as
# you use for SHARED_SECRET above.
